MINIOJ_SECRET_KEY=replace-with-a-long-random-secret
MINIOJ_DATABASE_URL=sqlite:///./database/oj.db
MINIOJ_DATA_DIR=./data
# Optional override; when omitted, jobs use MINIOJ_DATA_DIR/jobs.
MINIOJ_JOB_DIR=./data/jobs
MINIOJ_DOCKER_IMAGE=minioj-cpp20:latest
# Unique per concurrently running MiniOJ instance; used only for Docker cleanup labels.
MINIOJ_WORKER_OWNER=worker
# Feedback mode reported by GET /api/v1/me; always subject to account permissions.
# full: role-authorized previews; diagnostic: safe compile diagnostics/metadata.
# verdict_only: status/verdict, safe summary and known failure index; no contents.
# Restart Server after changes; Docker Compose must recreate the Server container.
MINIOJ_FEEDBACK_POLICY=full
MINIOJ_ROOT_PATH=
# Public example binds locally; set an explicit address for remote access.
MINIOJ_HTTP_BIND=127.0.0.1
MINIOJ_HTTP_PORT=80
# Optional host bind-mount overrides, useful for isolated deployment tests.
MINIOJ_DATABASE_DIR=./database
MINIOJ_DATA_HOST_DIR=./data
MINIOJ_SESSION_HTTPS_ONLY=false
MINIOJ_SOURCE_LIMIT_BYTES=262144
MINIOJ_STDIN_LIMIT_BYTES=262144
MINIOJ_OUTPUT_LIMIT_BYTES=8388608
MINIOJ_COMPILE_TIME_LIMIT_MS=30000
MINIOJ_COMPILE_MEMORY_MB=512
MINIOJ_CHECKER_TIME_LIMIT_MS=10000
MINIOJ_CHECKER_MEMORY_MB=512
MINIOJ_TESTCASE_FILE_LIMIT_BYTES=16777216
MINIOJ_TESTCASE_BUILD_TIME_LIMIT_MS=10000
MINIOJ_TESTCASE_BUILD_MEMORY_MB=512
MINIOJ_GENERATOR_MAX_CASES=50
MINIOJ_TOKEN_DEFAULT_DAYS=90
MINIOJ_MAX_QUEUED_SUBMISSIONS=1000
MINIOJ_MAX_QUEUED_RUNS=16
MINIOJ_CUSTOM_RUN_WAIT_SECONDS=45
MINIOJ_OVERLOAD_RETRY_AFTER_SECONDS=2
MINIOJ_POLYGON_ARCHIVE_LIMIT_BYTES=67108864
MINIOJ_POLYGON_EXPANDED_LIMIT_BYTES=268435456
# Optional first-start bootstrap system account (compatible ADMIN_* names):
# MINIOJ_ADMIN_USERNAME=admin
# MINIOJ_ADMIN_EMAIL=admin@example.com
# MINIOJ_ADMIN_PASSWORD=change-me-now
