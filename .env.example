MINIOJ_SECRET_KEY=replace-with-a-long-random-secret
MINIOJ_DATABASE_URL=sqlite:///./database/oj.db
MINIOJ_DATA_DIR=./data
MINIOJ_DOCKER_IMAGE=minioj-cpp20:latest
MINIOJ_FEEDBACK_POLICY=full
MINIOJ_ROOT_PATH=
MINIOJ_HTTP_BIND=100.95.57.121
MINIOJ_SESSION_HTTPS_ONLY=false
# Optional first-start bootstrap account:
# MINIOJ_ADMIN_USERNAME=admin
# MINIOJ_ADMIN_EMAIL=admin@example.com
# MINIOJ_ADMIN_PASSWORD=change-me-now

