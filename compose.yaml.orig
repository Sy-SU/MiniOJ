services:
  server:
    build: .
    command: uvicorn minioj.server.main:app --host 0.0.0.0 --port 8000
    environment:
      MINIOJ_DATABASE_URL: sqlite:////app/database/oj.db
      MINIOJ_DATA_DIR: /app/data
      MINIOJ_DOCKER_IMAGE: minioj-cpp20:latest
      MINIOJ_SECRET_KEY: ${MINIOJ_SECRET_KEY:-development-only-change-this-secret-key}
    ports:
      - "8000:8000"
    volumes:
      - ./database:/app/database
      - ./data:/app/data

